{
  "name": "mimic-language-support",
  "publisher": "mimic-org",
  "displayName": "Mimic Language Support",
  "description": "Mimic language support for Visual Studio Code.",
  "icon": "./assets/icon-128x128.jpg",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "url": "https://github.com/mimic-org/vscode-mimic-syntax/tree/main"
  },
  "contributes": {
    "languages": [{
      "id": "mimic",
      "aliases": ["Mimic Templating Language", "mimic"],
      "extensions": [".mimic"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./assets/icon.svg",
        "dark": "./assets/icon.svg"
      }
    }],
    "grammars": [{
      "language": "mimic",
      "scopeName": "source.mimic",
      "path": "./syntaxes/mimic.tmLanguage.json"
    }]
  }
}
